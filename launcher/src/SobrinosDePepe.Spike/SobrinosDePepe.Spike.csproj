<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SobrinosDePepe.Spike</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SobrinosDePepe.Core\SobrinosDePepe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\pack.json" Link="pack.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\overrides\**\*" Link="overrides\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

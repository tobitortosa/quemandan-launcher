<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SobrinosDePepe.App.ViewModels"
        xmlns:views="using:SobrinosDePepe.App.Views"
        x:Class="SobrinosDePepe.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="SOBRINOS DE PEPE"
        Icon="avares://SobrinosDePepe/Assets/icon.ico"
        Width="440" Height="620"
        MinWidth="420" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource GroundBrush}"
        TransparencyLevelHint="None">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:StartupViewModel">
      <views:StartupView />
    </DataTemplate>
    <DataTemplate DataType="vm:LoginViewModel">
      <views:LoginView />
    </DataTemplate>
    <DataTemplate DataType="vm:UpdateRequiredViewModel">
      <views:UpdateRequiredView />
    </DataTemplate>
    <DataTemplate DataType="vm:ChangePasswordViewModel">
      <views:ChangePasswordView />
    </DataTemplate>
    <DataTemplate DataType="vm:PendingViewModel">
      <views:PendingView />
    </DataTemplate>
    <DataTemplate DataType="vm:HomeViewModel">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="vm:AdminViewModel">
      <views:AdminView />
    </DataTemplate>
  </Window.DataTemplates>

  <ContentControl Content="{Binding Current}" />

</Window>

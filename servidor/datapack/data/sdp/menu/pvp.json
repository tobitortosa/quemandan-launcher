              "italic": false,
              "color": "gray"
            },
            {
              "text": "  ▪ Las bases NO estan protegidas",
              "italic": false,
              "color": "gray"
            },
            {
              "text": "",
              "italic": false
            },
            {
              "text": "  Lo que guardas en el ender chest no se",
              "italic": false,
              "color": "gray"
            },
            {
              "text": "  pierde al morir y nadie te lo puede robar.",
              "italic": false,
              "color": "gray"
            }
          ]
        }

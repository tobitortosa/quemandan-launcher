            "color": "#a503fc",
            "bold": true
          },
          "minecraft:lore": [
            {
              "text": "  ▪ 10 por matar a otro jugador",
              "italic": false,
              "color": "#a503fc"
            },
            {
              "text": "  ▪ 1 por cada 10 minutos jugados",
              "italic": false,
              "color": "gray"
            },
            {
              "text": "",
              "italic": false
            },
            {
              "text": "  El tiempo AFK no cuenta: hay que",
              "italic": false,
              "color": "dark_gray"
            },
            {
              "text": "  moverse para que el reloj corra.",
              "italic": false,
              "color": "dark_gray"
            },
            {
              "text": "",
              "italic": false
            },
            {
              "text": "  Los shards no se compran con plata",
              "italic": false,
              "color": "#ff5555"
            },
            {
              "text": "  ni se pueden pasar a otro jugador.",
              "italic": false,
              "color": "#ff5555"
            }
          ],
          "minecraft:tooltip_display": {
            "hidden_components": [
